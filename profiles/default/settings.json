{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "excludedCommands": [
      "git commit *",
      "git tag *",
      "git -C * commit *",
      "git -C * tag *",
      "git verify-commit *",
      "git verify-tag *"
    ],
    "filesystem": {
      "allowWrite": ["~/.cache/uv/"]
    },
    "network": {
      "allowedDomains": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    }
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(vigil-install-review:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash pop:*)",
      "Bash(git checkout -- *)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(npx:*)",
      "Bash(npm publish:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(telnet:*)",
      "Bash(ftp:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook session-start",   "timeout": 5  },
          { "type": "command", "command": "vigil-hook prune-worktrees", "timeout": 15 },
          { "type": "command", "command": "vigil-hook prune-logs",      "timeout": 15 },
          { "type": "command", "command": "vigil-hook policy-banner",   "timeout": 5  }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook prune-worktrees", "timeout": 15 },
          { "type": "command", "command": "vigil-hook session-end",     "timeout": 5  }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook log-tool-use",            "timeout": 5 },
          { "type": "command", "command": "vigil-hook validate-memory-write",   "timeout": 5 },
          { "type": "command", "command": "vigil-hook validate-settings-write", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook log-tool-use", "timeout": 5 }
        ]
      }
    ]
  }
}
