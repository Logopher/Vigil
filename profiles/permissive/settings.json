{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "excludedCommands": [
      "git commit *",
      "git tag *",
      "git -C * commit *",
      "git -C * tag *",
      "git verify-commit *",
      "git verify-tag *"
    ],
    "filesystem": {},
    "network": {
      "allowedDomains": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    }
  },
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(vigil-install-review:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook prune-worktrees", "timeout": 15 },
          { "type": "command", "command": "vigil-hook prune-logs",      "timeout": 15 },
          { "type": "command", "command": "vigil-hook policy-banner",   "timeout": 5  }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook prune-worktrees", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook log-tool-use",            "timeout": 5 },
          { "type": "command", "command": "vigil-hook validate-memory-write",   "timeout": 5 },
          { "type": "command", "command": "vigil-hook validate-settings-write", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "vigil-hook log-tool-use", "timeout": 5 }
        ]
      }
    ]
  }
}
