#!/usr/bin/env python3
"""vigil-hook — single dispatcher for Vigil hook events.

Installed to /usr/local/bin/ via sudo so an attacker confined to the user's
profile can't easily replace it. Hooks in ~/.claude/settings.json invoke
this binary by bare name with a subcommand argument; PATH lookup resolves
it.

Subcommands map 1:1 to the per-event scripts that previously lived under
profiles/<name>/hooks/:
    log-tool-use            PreToolUse / PostToolUse — append JSONL record
    validate-memory-write   PreToolUse — block cross-project memory writes
    validate-settings-write PreToolUse — block writes to Vigil core settings
    policy-banner           SessionStart — print active policy to stderr
    session-start           SessionStart — bridge wrapper-<pid>.json → <id>.json
    session-end             SessionEnd — clean up bridged session file
    prune-worktrees         SessionStart / SessionEnd — clean stale worktrees
    prune-logs              SessionStart — log retention (delegates to the
                            user-installed prune-logs.py helper)

All subcommands fail open (return 0) on parse errors or missing context so
edge cases never accidentally block tool calls. The two validators exit 2
with a JSON decision on stdout when they intend to deny.

The harness strips shell-exported env vars before invoking hook subprocesses,
so this script never depends on $HOME being set: os.path.expanduser('~') falls
back to getpwuid() when HOME is empty. To recover the wrapper's session
state across that strip, the bridge reads /proc/<ppid>/environ — claude's
own env, which retains VIGIL_WRAPPER_PID exported by the wrapper.
"""

import json
import os
import os.path
import shutil
import subprocess
import sys
from datetime import datetime, timezone


_WRITE_TOOLS = frozenset({'Write', 'Edit', 'MultiEdit'})


def _sessions_dir():
    home = os.path.expanduser('~')
    return os.path.join(home, '.config', 'vigil', 'sessions')


def _wrapper_pid_from_environ(ppid):
    """Extract VIGIL_WRAPPER_PID from /proc/<ppid>/environ.

    The hook's parent is claude, which inherited the wrapper's env at exec
    time. Reading claude's environ recovers the wrapper PID that the env
    strip on hook-subprocess launch would otherwise hide.
    """
    if not isinstance(ppid, int) or ppid <= 0:
        return None
    try:
        with open(f'/proc/{ppid}/environ', 'rb') as f:
            data = f.read()
    except OSError:
        return None
    for entry in data.split(b'\0'):
        if entry.startswith(b'VIGIL_WRAPPER_PID='):
            value = entry[len(b'VIGIL_WRAPPER_PID='):].decode('utf-8', errors='replace')
            # isdecimal() restricts to ASCII 0-9; isdigit() also accepts
            # non-ASCII digit characters which int() will happily parse
            # into garbage PID values.
            if value.isdecimal() and int(value) > 0:
                return int(value)
            return None
    return None


def _bridge_session(harness_session_id, ppid):
    """Promote wrapper-<pid>.json to <harness_session_id>.json.

    Idempotent: if the target already exists (a concurrent hook won the
    rename), returns the existing path. Returns None when no source file
    is reachable — the caller then fails open with no session context.
    """
    if not harness_session_id:
        return None
    sessions = _sessions_dir()
    target = os.path.join(sessions, f'{harness_session_id}.json')
    if os.path.isfile(target):
        return target
    wrapper_pid = _wrapper_pid_from_environ(ppid)
    if wrapper_pid is None:
        return None
    src = os.path.join(sessions, f'wrapper-{wrapper_pid}.json')
    if not os.path.isfile(src):
        return None
    try:
        os.rename(src, target)
    except OSError:
        if os.path.isfile(target):
            return target
        return None
    return target


def _load_session_context(harness_session_id, ppid):
    """Resolve the per-session context for this hook invocation.

    Tries the bridged file at ~/.config/vigil/sessions/
    <harness_session_id>.json, then a fresh bridge from wrapper-<pid>.json.
    Returns the parsed dict, or None when no source is available — hooks
    that need session context fail open in that case. After a successful
    load, ensures the wrapper-side bridge marker exists so the wrapper's
    post-exec sidecar can map vigil_session_id → harness_session_id
    without parsing the tools log.
    """
    bridged = None
    if harness_session_id:
        candidate = os.path.join(_sessions_dir(), f'{harness_session_id}.json')
        if os.path.isfile(candidate):
            bridged = candidate
    if bridged is None:
        bridged = _bridge_session(harness_session_id, ppid)
    if bridged is None:
        return None
    try:
        with open(bridged) as f:
            ctx = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    _ensure_bridge_marker(harness_session_id, ctx)
    return ctx


def _ensure_bridge_marker(harness_session_id, ctx):
    """Drop ~/vigil-logs/.bridge-<vigil_session_id> for the wrapper.

    The wrapper's post-exec sidecar code reads this single-line marker
    to learn the harness session_id (the harness assigns it after exec
    so the wrapper has no other way to recover it without parsing the
    tools log). Idempotent via exclusive-create: a concurrent hook
    losing the race observes FileExistsError and does nothing. The
    wrapper's EXIT trap removes the marker when the session ends.
    """
    if not harness_session_id or not isinstance(ctx, dict):
        return
    vigil_session_id = ctx.get('vigil_session_id') or ''
    log_dir = ctx.get('log_dir') or ''
    if not vigil_session_id or not log_dir:
        return
    marker = os.path.join(log_dir, f'.bridge-{vigil_session_id}')
    try:
        os.makedirs(log_dir, exist_ok=True)
        with open(marker, 'x') as f:
            f.write(harness_session_id + '\n')
    except FileExistsError:
        pass
    except OSError:
        pass


def _ctx_vigil_session_id(ctx):
    """Read the Vigil session id from the per-session JSON."""
    return ctx.get('vigil_session_id') or ''


def _ctx_launch_cwd(ctx):
    """Read the wrapper-recorded launch CWD from the per-session JSON."""
    if not isinstance(ctx, dict):
        return ''
    return ctx.get('cwd') or ''


# ---------- log-tool-use ----------

def cmd_log_tool_use():
    try:
        event_data = json.load(sys.stdin)
    except (ValueError, OSError, UnicodeDecodeError):
        return 0
    if not isinstance(event_data, dict):
        return 0

    harness_session_id = event_data.get('session_id', '')
    ctx = _load_session_context(harness_session_id, os.getppid())
    if not ctx:
        return 0
    log_dir = ctx.get('log_dir', '')
    vigil_session_id = _ctx_vigil_session_id(ctx)
    if not log_dir or not harness_session_id:
        return 0

    hook_event = event_data.get('hook_event_name', '')
    # Records carry both IDs as content fields. harness_session_id is
    # the canonical key (the filename is tools-<harness_session_id>.jsonl
    # and it also names the per-session JSONL under ~/.claude/projects/<slug>/);
    # vigil_session_id is the wall-clock-derived wrapper anchor that names
    # the session-*.log / .txt / .json sidecar files.
    record = {
        'ts': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
        'vigil_session_id': vigil_session_id,
        'harness_session_id': harness_session_id,
        'event': hook_event,
        'tool': event_data.get('tool_name', ''),
        'tool_use_id': event_data.get('tool_use_id', ''),
    }
    if hook_event == 'PreToolUse':
        record['input'] = event_data.get('tool_input', {})
    elif hook_event == 'PostToolUse':
        record['duration_ms'] = event_data.get('duration_ms')
        if 'error' in event_data:
            record['error'] = event_data['error']
        else:
            record['response'] = event_data.get('tool_response', {})

    try:
        os.makedirs(log_dir, exist_ok=True)
        log_path = os.path.join(log_dir, f'tools-{harness_session_id}.jsonl')
        record_line = json.dumps(record) + '\n'
        # Emit a schema_version meta record on first write so the tools-JSONL
        # contract is observable to readers. Atomic with file creation via
        # O_CREAT|O_EXCL: at most one writer creates the file and emits the
        # meta record; concurrent writers losing the race observe
        # FileExistsError and fall through to append-only. The meta and
        # first event are written together, so partial states (file exists
        # but lacks the meta record) are not reachable through this path.
        meta_line = json.dumps({
            'ts': record['ts'],
            'event': 'meta',
            'schema_version': 1,
        }) + '\n'
        try:
            # Position 0 is safe here because O_EXCL guarantees the file
            # was empty at open time; no O_APPEND is needed for the single
            # os.write below. Do not copy this open into a retry path —
            # without O_EXCL, position 0 would silently overwrite data.
            fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
            try:
                os.write(fd, (meta_line + record_line).encode())
            finally:
                os.close(fd)
        except FileExistsError:
            with open(log_path, 'a') as f:
                f.write(record_line)
    except OSError:
        pass
    return 0


# ---------- validate-memory-write ----------

def cmd_validate_memory_write():
    try:
        event_data = json.load(sys.stdin)
    except (ValueError, OSError, UnicodeDecodeError):
        return 0
    if not isinstance(event_data, dict):
        return 0
    if event_data.get('tool_name') not in _WRITE_TOOLS:
        return 0

    tool_input = event_data.get('tool_input', {})
    file_path = tool_input.get('file_path', '')
    if not file_path:
        return 0

    file_path = os.path.normpath(os.path.expanduser(file_path))
    home = os.path.expanduser('~')
    memory_base = os.path.join(home, '.claude', 'projects')

    if not file_path.startswith(memory_base + os.sep):
        return 0

    rel = file_path[len(memory_base) + 1:]
    parts = rel.split(os.sep, 2)
    if len(parts) < 2 or parts[1] != 'memory':
        return 0

    target_slug = parts[0]
    # Source the session's project slug from the wrapper-recorded launch
    # cwd, not event_data['cwd']. The harness updates event_data['cwd']
    # whenever the LLM runs `cd` via the Bash tool, so deriving the slug
    # from it would drift away from the fixed slug Claude Code assigned
    # at session launch and cause same-project memory writes to be denied.
    harness_session_id = event_data.get('session_id', '')
    ctx = _load_session_context(harness_session_id, os.getppid())
    if ctx is None:
        print('vigil-hook validate-memory-write: session context unavailable; allowing write',
              file=sys.stderr)
        return 0
    launch_cwd = _ctx_launch_cwd(ctx)
    if not launch_cwd:
        print('vigil-hook validate-memory-write: launch cwd missing from session context; allowing write',
              file=sys.stderr)
        return 0

    # Slug algorithm: normpath then replace('/', '-') on an absolute path.
    # Claude Code's own project-storage scheme produces the same slug from
    # the launch cwd — `/home/grault/code/vigil` becomes
    # `-home-grault-code-vigil`, leading `-` and all — so the comparison
    # against target_slug (extracted from the file path's
    # ~/.claude/projects/<slug>/ component) is apples-to-apples. If a
    # future Claude Code release ever stops emitting the leading `-`, the
    # tests at tests/vigil-hook.sh will fail (same-project writes start
    # being denied) before this rolls out. Do not "fix" the leading `-`
    # without also realigning Claude Code's actual slug layout.
    expected_slug = os.path.normpath(launch_cwd).replace('/', '-')
    if target_slug == expected_slug:
        return 0

    decision = {
        'hookSpecificOutput': {
            'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny',
            'permissionDecisionReason': (
                f'Cross-project memory write blocked: '
                f'target slug {target_slug!r} does not match '
                f'current session slug {expected_slug!r}. '
                f'Memory writes are only allowed within the current project.'
            ),
        }
    }
    print(json.dumps(decision))
    return 2


# ---------- validate-settings-write ----------

def cmd_validate_settings_write():
    try:
        event_data = json.load(sys.stdin)
    except (ValueError, OSError, UnicodeDecodeError):
        return 0
    if not isinstance(event_data, dict):
        return 0
    if event_data.get('tool_name') not in _WRITE_TOOLS:
        return 0

    tool_input = event_data.get('tool_input', {})
    file_path = tool_input.get('file_path', '')
    if not file_path:
        return 0

    file_path = os.path.normpath(os.path.expanduser(file_path))
    home = os.path.expanduser('~')
    protected = frozenset([
        os.path.join(home, '.claude', 'settings.json'),
        os.path.join(home, '.claude', 'settings.local.json'),
        os.path.join(home, '.claude', 'keybindings.json'),
    ])

    if file_path not in protected:
        return 0

    decision = {
        'hookSpecificOutput': {
            'hookEventName': 'PreToolUse',
            'permissionDecision': 'deny',
            'permissionDecisionReason': (
                f'Settings write blocked: {file_path} is a Vigil-protected '
                f'configuration file. Modifications require direct shell access '
                f'outside the Claude session.'
            ),
        }
    }
    print(json.dumps(decision))
    return 2


# ---------- policy-banner ----------

def cmd_policy_banner():
    try:
        event_data = json.load(sys.stdin)
    except (ValueError, OSError, UnicodeDecodeError):
        event_data = {}
    harness_session_id = ''
    if isinstance(event_data, dict):
        harness_session_id = event_data.get('session_id', '') or ''

    ctx = _load_session_context(harness_session_id, os.getppid())
    if not ctx:
        return 0
    policy = ctx.get('policy', '')
    vigil_session_id = _ctx_vigil_session_id(ctx)
    if not policy:
        return 0
    banner = f'[vigil] active policy: {policy}  |  session: {vigil_session_id}'
    if harness_session_id:
        banner += f'  |  harness: {harness_session_id}'
    print(banner, file=sys.stderr)
    return 0


# ---------- session-start ----------

def cmd_session_start():
    """Eagerly bridge wrapper-<pid>.json and write the bridge marker.

    _load_session_context performs both the rename and the marker write;
    invoking it here at SessionStart concentrates the work in one fire
    so subsequent hooks just open the already-bridged file.
    """
    try:
        event_data = json.load(sys.stdin)
    except (ValueError, OSError, UnicodeDecodeError):
        return 0
    if not isinstance(event_data, dict):
        return 0
    harness_session_id = event_data.get('session_id', '')
    if not harness_session_id:
        return 0
    _load_session_context(harness_session_id, os.getppid())
    return 0


# ---------- session-end ----------

def cmd_session_end():
    """Remove ~/.config/vigil/sessions/<harness_session_id>.json.

    The wrapper's EXIT trap owns any leftover wrapper-<pid>.json (if
    SessionStart never bridged); this handler is the symmetric cleanup
    for the file SessionStart created.
    """
    try:
        event_data = json.load(sys.stdin)
    except (ValueError, OSError, UnicodeDecodeError):
        return 0
    if not isinstance(event_data, dict):
        return 0
    harness_session_id = event_data.get('session_id', '')
    if not harness_session_id:
        return 0
    target = os.path.join(_sessions_dir(), f'{harness_session_id}.json')
    try:
        os.remove(target)
    except OSError:
        pass
    return 0


# ---------- prune-worktrees ----------

def _git(repo, *args):
    """Run git -C repo *args; return (success, stdout)."""
    try:
        result = subprocess.run(
            ['git', '-C', repo, *args],
            capture_output=True, text=True, check=False,
        )
        return result.returncode == 0, result.stdout
    except (OSError, subprocess.SubprocessError):
        return False, ''


def cmd_prune_worktrees():
    """Port of profiles/<name>/hooks/prune-worktrees.sh.

    Three load-bearing invariants — see the project CLAUDE.md before changing:
      1. Never removes a worktree directory with uncommitted changes.
      2. Never prunes git metadata for a dirty worktree.
      3. Only deletes claude/* branches fully merged into main (git branch -d).
    Worktrees are matched by basename (not full path) to survive Windows /
    MSYS2 path-format mismatches.
    """
    cwd = os.getcwd()
    ok, repo_root = _git(cwd, 'rev-parse', '--show-toplevel')
    if not ok:
        return 0
    repo_root = repo_root.strip()
    if not repo_root:
        return 0

    worktree_dir = os.path.join(repo_root, '.claude', 'worktrees')

    ok, porcelain = _git(repo_root, 'worktree', 'list', '--porcelain')
    active_names = set()
    active_branches = set()
    if ok:
        for line in porcelain.splitlines():
            if line.startswith('worktree '):
                active_names.add(os.path.basename(line[len('worktree '):]))
            elif line.startswith('branch refs/heads/'):
                active_branches.add(line[len('branch refs/heads/'):])

    dirty_worktrees = []
    protected_names = set()
    if os.path.isdir(worktree_dir):
        for entry in sorted(os.listdir(worktree_dir)):
            full = os.path.join(worktree_dir, entry)
            if not os.path.isdir(full):
                continue
            if entry in active_names:
                continue
            if os.path.isfile(os.path.join(full, '.git')):
                ok2, status = _git(full, 'status', '--porcelain')
                if ok2 and status.strip():
                    dirty_worktrees.append(entry)
                    protected_names.add(entry)

    _git(repo_root, 'worktree', 'prune')

    # Invariant #2 safety check.
    for entry in protected_names:
        full = os.path.join(worktree_dir, entry)
        if not os.path.isfile(os.path.join(full, '.git')):
            print(f'WARNING: git metadata was pruned for dirty worktree: {entry}')

    # Invariant #1: only remove clean stale directories.
    if os.path.isdir(worktree_dir):
        for entry in sorted(os.listdir(worktree_dir)):
            full = os.path.join(worktree_dir, entry)
            if not os.path.isdir(full):
                continue
            if entry in active_names or entry in protected_names:
                continue
            try:
                shutil.rmtree(full)
            except OSError:
                pass
        try:
            for entry in os.listdir(worktree_dir):
                full = os.path.join(worktree_dir, entry)
                if os.path.isdir(full):
                    try:
                        os.rmdir(full)
                    except OSError:
                        pass
        except OSError:
            pass

    if dirty_worktrees:
        print('Stale worktrees with uncommitted changes (not removed):')
        for w in dirty_worktrees:
            print(f'  {w}')

    # Invariant #3: safe-delete only.
    ok, branches = _git(repo_root, 'branch', '--list', 'claude/*',
                         '--format=%(refname:short)')
    unmerged = []
    if ok:
        for branch in branches.splitlines():
            branch = branch.strip()
            if not branch or branch in active_branches:
                continue
            del_ok, _ = _git(repo_root, 'branch', '-d', branch)
            if del_ok:
                print(f'Deleted merged branch: {branch}')
            else:
                unmerged.append(branch)

    if unmerged:
        print('Unmerged orphan claude/* branches (need manual review):')
        for b in unmerged:
            print(f'  {b}')

    return 0


# ---------- prune-logs ----------

def cmd_prune_logs():
    """Delegate to the user-installed prune-logs.py helper.

    The helper has its own CLI (vigil-log-prune wrapper) and stays under
    ~/.config/vigil/scripts/ — vigil-hook does not duplicate its logic.
    """
    home = os.path.expanduser('~')
    helper = os.path.join(home, '.config', 'vigil', 'scripts', 'prune-logs.py')
    if not os.path.isfile(helper):
        return 0
    try:
        subprocess.run(['python3', helper, *sys.argv[2:]], check=False)
    except (OSError, subprocess.SubprocessError):
        pass
    return 0


# ---------- dispatcher ----------

_COMMANDS = {
    'log-tool-use':            cmd_log_tool_use,
    'validate-memory-write':   cmd_validate_memory_write,
    'validate-settings-write': cmd_validate_settings_write,
    'policy-banner':           cmd_policy_banner,
    'session-start':           cmd_session_start,
    'session-end':             cmd_session_end,
    'prune-worktrees':         cmd_prune_worktrees,
    'prune-logs':              cmd_prune_logs,
}


def main():
    prog = os.path.basename(sys.argv[0])
    if len(sys.argv) < 2:
        print(f'usage: {prog} <subcommand>', file=sys.stderr)
        print('subcommands: ' + ', '.join(sorted(_COMMANDS)), file=sys.stderr)
        return 2

    handler = _COMMANDS.get(sys.argv[1])
    if handler is None:
        print(f'{prog}: unknown subcommand: {sys.argv[1]}', file=sys.stderr)
        return 2
    return handler()


if __name__ == '__main__':
    sys.exit(main())
